# Local practice runs with no key and sends no material to an AI provider.
STUDY_GENERATION_MODE=local_practice
STUDY_DATA_DIR=.study-data

# Leave blank until you explicitly enable and configure the provider later.
OPENAI_API_KEY=
OPENAI_MODEL=

# Public local models; documents stay on this server during OCR and embedding.
STUDY_MODEL_DIR=.study-models
STUDY_MODELS_OFFLINE=false
STUDY_OCR_REVIEW_THRESHOLD=0.98
STUDY_PDF_TIMEOUT_SECONDS=180
