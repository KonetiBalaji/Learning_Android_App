LEARNING_API_IMAGE=ghcr.io/owner/learning-api@sha256:replace-with-reviewed-digest
LEARNING_RELEASE_REVISION=replace-with-40-character-git-commit
LEARNING_JWT_SECRET=inject-from-host-secret-manager
OPENAI_API_KEY=inject-from-host-secret-manager
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LEARNING_GOOGLE_CLIENT_ID=
LEARNING_RUNTIME_VOLUME=learning-runtime-production
LEARNING_TLS_DIR=/absolute/host/path/to/tls
LEARNING_HTTPS_BIND=0.0.0.0:443
LEARNING_WEB_CONCURRENCY=2
